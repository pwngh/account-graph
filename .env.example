# Local Compose example. Use synthetic settings here. docs/operations.md lists the variables.
# Supply real provider credentials privately outside the checkout. live-check reads only its process environment.
# Make each secret with: openssl rand -hex 32
GRAPH_TOKEN=
REVIEW_TOKENS={"your-name":""}
LINK_SECRET=
# Marks the keys your systems send, so a retry is known. Keep every one that was ever used: the first signs, and all are tried.
RECEIPT_SECRETS=
# The sites whose pages report visits, separated by commas.
ORIGINS=https://example.org
# Set these behind a proxy you run.
#TRUST_PROXY=true
#COOKIE=true

{
  "name": "account-graph",
  "version": "0.1.0",
  "description": "Link accounts by shared identifiers and attribute conversions, in six calls",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwngh/account-graph.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "account-graph": "./dist/bin.js"
  },
  "files": [
    "dist",
    "examples/household.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/remote.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.ts",
      "default": "./dist/edge/index.js"
    },
    "./collect": {
      "types": "./dist/edge/browser.d.ts",
      "default": "./dist/edge/browser.js"
    },
    "./hardware": {
      "types": "./dist/edge/hardware.d.ts",
      "default": "./dist/edge/hardware.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/edge/review && cp -R src/edge/review dist/edge/review",
    "demo": "node demo.ts",
    "firm": "node examples/firm.ts",
    "bench": "node bench.ts",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "review": "node tools/review-demo.ts",
    "start": "node src/bin.ts",
    "live-check": "node tools/live-check.ts",
    "costs": "node tools/costs.ts",
    "labels": "node tools/labels.ts"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "typescript": "^5.8.0"
  }
}

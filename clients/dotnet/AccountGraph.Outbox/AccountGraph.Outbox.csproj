<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AccountGraph</RootNamespace>
    <PackageId>AccountGraph.Outbox</PackageId>
    <Description>A durable SQLite outbox of record entries for the account-graph .NET client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AccountGraph/AccountGraph.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>
